# Beta deployment profile. Invoke deploy-ci.sh with
# HELM_DEPLOY_ENVIRONMENT=beta so this environment can never reuse the
# production deployment account, gateway, signing trust, or guest.
PVE_HOST=10.0.0.20
PVE_DEPLOY_USER=helm-beta-deploy
CTID=106
CT_NAME=helm-beta
CT_IP=10.0.0.39
CT_GATEWAY=10.0.0.1
CT_CIDR_PREFIX=24
PVE_TEMPLATE=local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst
PVE_STORAGE=local-lvm
PVE_BRIDGE=vmbr0
CT_MEMORY_MB=2048
CT_DISK_GB=16

# The selected beta hostname is private Tailnet/split-DNS only. Public
# Cloudflare beta provisioning is disabled; this profile never bundles or
# restarts cloudflared. The CT must be preprovisioned with the owner environment
# and origin credentials described in docs/BETA_DEPLOYMENT_PLAN.md.
HELM_PUBLIC_ORIGIN=https://beta-helm.home.shanekanterman.dev
HELM_ADMIN_EMAIL=owner@example.com
HELM_TAILNET_OWNER_LOGIN=ShaneKanterman04@github
HELM_TAILNET_AUDIENCE=https://beta-helm.home.shanekanterman.dev
HELM_TAILNET_ASSERTION_KEY_FILE=/etc/roadmap/tailnet.key
HELM_TAILNET_TLS_ADDR=10.0.0.39:8443
HELM_TAILNET_TLS_CERT_FILE=/etc/roadmap/tailnet-origin.crt
HELM_TAILNET_TLS_KEY_FILE=/etc/roadmap/tailnet-origin.key
# homelab-edge forwards the private HTTPS origin over the LAN; CT 106 does
# not require or select a tailscale interface for this ingress.
HELM_TAILNET_ALLOWED_PEER_IPS=10.0.0.101
HELM_RELEASE_RETENTION=5
HELM_BACKUP_RETENTION=14
