# Native package defaults. Set authentication and public-origin values for the
# deployment before enabling helm.service. Secrets do not belong in this file.
HELM_ADDR=127.0.0.1:8080
HELM_AUTH_MODE=local
HELM_PUBLIC_ORIGIN=http://127.0.0.1:8080
HELM_SECURE_COOKIES=false
HELM_DEMO_SEED=false
# Luna is opt-in for native packages. Install the optional Codex companion and
# set this to true only when that feature has been explicitly enabled.
HELM_LUNA_ENABLED=false
