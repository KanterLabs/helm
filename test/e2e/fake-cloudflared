#!/usr/bin/env bash
# cloudflared stand-in for E2E: fake-cloudflared LOG tunnel --no-autoupdate run
# Records argv and only a SHA-256 of TUNNEL_TOKEN, then stays connected.
set -euo pipefail
log=$1
shift
token_env=no
[[ -n "${TUNNEL_TOKEN:-}" ]] && token_env=yes
token_sha=$(printf '%s' "${TUNNEL_TOKEN:-}" | sha256sum | cut -d' ' -f1)
printf '{"argv":"%s","token_env":"%s","token_sha256":"%s"}\n' "$*" "$token_env" "$token_sha" >> "$log"
printf '2026-01-01T00:00:00Z INF Registered tunnel connection connIndex=0 location=e2e\n' >&2
trap 'exit 0' TERM INT
while :; do sleep 1; done
