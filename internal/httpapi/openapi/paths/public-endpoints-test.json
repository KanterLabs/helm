{
  "paths": {
    "/api/v1/public-endpoints/{endpoint}/test": {
      "parameters": [
        {
          "name": "endpoint",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identifier"
          }
        }
      ],
      "post": {
        "operationId": "testPublicEndpoint",
        "summary": "Test the active public URL",
        "description": "Human administrators only. Helm sends one GET from the server to\n`https://{hostname}/api/v1/hooks/tickets/probe/{nonce}` and expects\nits hooks listener to echo the one-time nonce. Success proves DNS,\nCloudflare's edge, the tunnel and its routing reach this Helm. No\nticket is created. A failed round trip is still HTTP 200 with\n`ok: false` and a `message` explaining the likely cause.\n",
        "tags": [
          "Tickets"
        ],
        "responses": {
          "200": {
            "description": "Test completed",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicEndpointTestResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  }
}
