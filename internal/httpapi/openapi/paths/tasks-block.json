{
  "paths": {
    "/api/v1/tasks/{task}/block": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskPath"
        }
      ],
      "post": {
        "operationId": "blockTask",
        "summary": "Block a task",
        "description": "Moves the task to the project's blocked semantic column. A human\nadministrator may explicitly override an active claim held by another\nactor; bearer tokens and ordinary human actors cannot.\n",
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockRequest"
              },
              "example": {
                "reason": "Waiting for API credentials."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blocked task; humans and bearer tokens with tasks:read receive the full task, while claim-only bearer tokens receive only id/version metadata.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskMutationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/StaleTask"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
