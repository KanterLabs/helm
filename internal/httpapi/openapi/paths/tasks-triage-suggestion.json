{
  "paths": {
    "/api/v1/tasks/{task}/triage-suggestion": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskPath"
        }
      ],
      "post": {
        "operationId": "suggestTaskTriage",
        "summary": "Suggest priority and readiness for a saved task",
        "description": "Uses the signed-in human's key to evaluate a bounded copy of the saved title and description. The suggestion is advisory and the task remains at the same version.",
        "tags": [
          "Tasks"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "cloudflareAccess": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The suggestion and the version of the evaluated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "priority",
                    "readiness",
                    "task_version"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "priority": {
                      "type": "string",
                      "enum": [
                        "low",
                        "normal",
                        "high",
                        "urgent",
                        "insufficient_context"
                      ]
                    },
                    "readiness": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "needs_details",
                        "needs_decision"
                      ]
                    },
                    "task_version": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "description": "OpenAI rejected the key or project access"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
