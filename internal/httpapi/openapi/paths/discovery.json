    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Fetch production metrics",
        "description": "Returns bounded Prometheus text. Unauthenticated requests are accepted only from a loopback peer without forwarding or proxy identity headers; a loopback request carrying those headers is treated as proxied and requires a Helm session or scoped bearer token. Metrics never contain task text, request bodies, credentials, or user-provided labels. Unknown API paths and non-standard methods use bounded labels. Remote authenticated collection uses the normal auth path and may update throttled session or token usage bookkeeping.",
        "tags": [
          "Health"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Prometheus metrics",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
