{
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check process liveness",
        "description": "Returns 200 when the HTTP process is alive. This endpoint does not require authentication.",
        "tags": [
          "Health"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                },
                "example": {
                  "status": "ok",
                  "service": "helm",
                  "revision": "0123456789abcdef0123456789abcdef01234567"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check service readiness",
        "description": "Returns bounded machine-readable database, schema, migration, writable-capacity, and storage checks. It returns 200 when all checks pass and 503 with status degraded when a check fails. Unknown newer additive migrations are reported as a compatibility warning for retained-binary rollback and do not by themselves fail readiness. Writable-capacity is a read-only preflight and cannot prove ACL or effective-user write access.",
        "tags": [
          "Health"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "Service is ready",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                },
                "example": {
                  "status": "ok",
                  "service": "helm",
                  "revision": "0123456789abcdef0123456789abcdef01234567"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "description": "Service is not ready",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
