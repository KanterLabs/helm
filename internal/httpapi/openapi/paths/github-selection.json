{
  "paths": {
    "/api/v1/projects/{project}/github": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectPath"
        }
      ],
      "get": {
        "operationId": "getProjectGithub",
        "summary": "Get selected GitHub repositories",
        "description": "Requires tasks:read and project access. Returns local selection without contacting GitHub; unsaved selections have version 1 and an empty repository array.",
        "tags": [
          "GitHub"
        ],
        "externalDocs": {
          "description": "GitHub beta API guide",
          "url": "docs/GITHUB_BETA_API.md"
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GithubSelection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "operationId": "setProjectGithub",
        "summary": "Select project GitHub repositories",
        "description": "Human administrator with project access. Select unique allowed repository/ref pairs, at most ten; use the selection ETag as If-Match. A change invalidates old cached access and in-flight writes.",
        "tags": [
          "GitHub"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "cloudflareAccess": []
          }
        ],
        "externalDocs": {
          "description": "GitHub beta API guide",
          "url": "docs/GITHUB_BETA_API.md"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GithubSelectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GithubSelection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/projects/{project}/github/readiness": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectPath"
        }
      ],
      "get": {
        "operationId": "getProjectGithubReadiness",
        "summary": "Check audit connection readiness",
        "description": "Requires project access. Humans check their own personal AI readiness. Agents require tasks:read and authorization_id matching their exact agent/token and project; checks the granting human account. Checks GitHub and AI readiness without inference. Audit start validates execution again.",
        "tags": [
          "GitHub"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "cloudflareAccess": []
          },
          {
            "bearerAuth": []
          }
        ],
        "externalDocs": {
          "description": "GitHub beta API guide",
          "url": "docs/GITHUB_BETA_API.md"
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GithubReadiness"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "parameters": [
          {
            "name": "authorization_id",
            "in": "query",
            "required": false,
            "description": "Required for agents; omitted for humans. Must identify a matching unexpired, unrevoked grant.",
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        ]
      }
    }
  }
}
