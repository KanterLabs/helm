{
  "paths": {
    "/api/v1/codex/logout": {
      "post": {
        "operationId": "logoutCodexAccount",
        "summary": "Remove the current human user's Codex connection",
        "description": "Logs out through Codex App Server and closes the actor-isolated runtime.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Codex account disconnected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
