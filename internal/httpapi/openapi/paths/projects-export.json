{
  "paths": {
    "/api/v1/projects/{project}/export": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectPath"
        }
      ],
      "get": {
        "operationId": "exportProjectPortableArchive",
        "summary": "Export one project's portable archive",
        "description": "Exports live project records as a helm.portable v4 JSON archive, preserving checklists, hierarchy, completion policy, Focus, bugs, dependencies, comments, agent history and retained PR/audit history. Explicit versions 2 and 3 remain available with omission warnings. Credentials, repository selections, provider caches and executable jobs are excluded. Requires projects:read, tasks:read and events:read. Source access is revalidated before private retained evidence is exported.",
        "tags": [
          "Projects"
        ],
        "responses": {
          "200": {
            "description": "Portable archive JSON attachment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortableArchive"
                }
              }
            },
            "headers": {
              "X-Helm-Portable-Version": {
                "description": "Selected portable envelope version.",
                "schema": {
                  "type": "integer",
                  "enum": [
                    2,
                    3,
                    4
                  ],
                  "example": 4
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "Defaults to complete version 4. Versions 2 and 3 omit checklists, hierarchy and completion policy and include warnings.",
            "schema": {
              "type": "integer",
              "enum": [
                2,
                3,
                4
              ],
              "default": 4
            }
          }
        ]
      }
    }
  }
}
