{
  "paths": {
    "/api/v1/intake/coolify/{secret}": {
      "post": {
        "operationId": "receiveCoolifyAlert",
        "summary": "Receive a Coolify webhook notification",
        "description": "Coolify webhook target. The path secret is the only credential because\nCoolify webhooks carry no signature or custom headers; it is configured\nthrough `HELM_COOLIFY_WEBHOOK_SECRET_FILE` and never logged. A disabled\nintake and a wrong secret both return the generic `404`.\n\n`traefik_version_outdated` records one condition per server, keyed by\nserver UUID and offered version, in a single transaction. A new\ncondition creates an assigned, unclaimed task in the ticket queue's\nNeeds triage column and notifies the assignee once. A known\ncondition only increments its occurrence count: the task is never\nedited, reopened or recreated (`repeated` when open, `retained` when\ncompleted or deleted). `test` is `ignored`; other events are\n`unsupported`. Both create no work. Any invalid server rejects the\nwhole delivery.\n",
        "tags": [
          "Alert intake"
        ],
        "security": [
          {}
        ],
        "parameters": [
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "description": "Operator-provisioned intake secret.",
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event"
                ],
                "properties": {
                  "event": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,128}$"
                  },
                  "servers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 25,
                    "items": {
                      "type": "object",
                      "required": [
                        "uuid",
                        "current_version",
                        "latest_version"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "uuid": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,64}$"
                        },
                        "current_version": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._+-]{1,32}$"
                        },
                        "latest_version": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._+-]{1,32}$"
                        },
                        "update_type": {
                          "type": "string"
                        },
                        "upgrade_target": {
                          "type": "string"
                        },
                        "newer_branch_target": {
                          "type": "string"
                        },
                        "newer_branch_latest": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "additionalProperties": true
              },
              "example": {
                "success": false,
                "message": "Traefik proxy outdated",
                "event": "traefik_version_outdated",
                "affected_servers_count": 1,
                "servers": [
                  {
                    "name": "localhost",
                    "uuid": "k8s0c4w",
                    "current_version": "v3.1.2",
                    "latest_version": "v3.1.5",
                    "update_type": "patch_update"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delivery recorded, ignored, or unsupported",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertIntakeResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
