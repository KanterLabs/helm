{
  "paths": {
    "/api/v1/projects/{project}/timeline": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectPath"
        }
      ],
      "get": {
        "operationId": "listProjectTimeline",
        "summary": "List unified project activity",
        "description": "Return the durable newest-first activity stream for every non-deleted\ntask in the selected project, merging structured agent progress,\ncomments, and task-change events. The response uses stable opaque\nkeyset cursors: pass `next_cursor` as `before` to load older activity.\nGenerated progress comments and their `comment.created` events are\nrepresented once by the corresponding `agent_progress` item. Legacy\ncomments and events remain available as comments or generic\n`task_change` items without inferred progress fields. Timeline reads\nrequire `tasks:read` and honor the caller's project access ceiling.\n",
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BeforeTimelineCursor"
          },
          {
            "$ref": "#/components/parameters/TimelineKind"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Newest-first unified project activity page",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskTimelineCollection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
