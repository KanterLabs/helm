{
  "paths": {
    "/api/v1/tasks/{task}/move": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskPath"
        }
      ],
      "post": {
        "operationId": "moveTask",
        "summary": "Apply a guarded task move",
        "description": "Moves an unfinished task to a backlog or ready column only. Task\nmoves require `tasks:write`, the exact current task ETag in `If-Match`,\nand an `Idempotency-Key`. The expected source column is guarded in the\nsame transaction as the task version and active-claim check; any live\nclaim, including the caller's own, rejects the move. The server\ncomputes the destination position atomically when no anchors are\nsupplied, so `position` is not a request field. Optional before/after\nanchors provide precise placement and are guarded by column ordering\nrevisions. A successful move emits a `task.moved` event. This is\nthe explicit apply step after a client has reviewed an audit finding;\naudit reads and finding review never apply moves.\n",
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskMoveRequest"
              },
              "example": {
                "destination_column_id": "col_ready",
                "expected_source_column_id": "col_backlog",
                "source": "board_audit",
                "reason": "Approved board-audit recommendation."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Moved task; the server allocated its destination position and emitted task.moved.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskMutationResponse"
                },
                "examples": {
                  "task": {
                    "$ref": "#/components/examples/TaskExample"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/TaskMutationConflict"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
