{
  "paths": {
    "/api/v1/projects/{project}/task-draft": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectPath"
        }
      ],
      "post": {
        "operationId": "draftTaskWithLuna",
        "summary": "Generate a structured Luna task suggestion",
        "description": "Uses the requesting human's connected Codex subscription and bounded project context. This preview never creates or mutates a task.",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskContextRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated task suggestion",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDraftSuggestion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
