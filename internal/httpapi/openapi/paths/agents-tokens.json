{
  "paths": {
    "/api/v1/agents/{agent}/tokens": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AgentPath"
        }
      ],
      "post": {
        "operationId": "createAgentToken",
        "summary": "Create a scoped agent token",
        "description": "The plaintext token is returned only in this response and is never\nreturned by later reads. This operation deliberately rejects an\nIdempotency-Key because replay caching would retain the plaintext.\n",
        "tags": [
          "Agents"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "cloudflareAccess": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenCreateRequest"
              },
              "example": {
                "name": "CI polling token",
                "scopes": [
                  "projects:read",
                  "tasks:read",
                  "tasks:claim",
                  "events:read"
                ],
                "project_ids": [
                  "proj_ops"
                ],
                "expires_at": "2027-01-01T00:00:00Z"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created; save the plaintext token now",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              },
              "X-Roadmap-Revision": {
                "$ref": "#/components/headers/XRoadmapRevision"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenCreated"
                },
                "examples": {
                  "token": {
                    "$ref": "#/components/examples/TokenCreatedExample"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/RequestTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  }
}
