{
  "components": {
    "schemas": {
      "TimelineActor": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "TaskTimelineProgress": {
        "type": "object",
        "required": [
          "operation_id",
          "actor_id",
          "state",
          "phase",
          "summary",
          "next_action",
          "checkpoint_refs",
          "checkpoint_completed",
          "checkpoint_total",
          "started_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "actor_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "state": {
            "type": "string",
            "enum": [
              "working",
              "waiting",
              "verifying",
              "handoff"
            ]
          },
          "phase": {
            "type": "string",
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "next_action": {
            "type": "string",
            "maxLength": 1000
          },
          "checkpoint_refs": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "checkpoint_completed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "checkpoint_total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "started_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "additionalProperties": false
      },
      "TaskTimelineChange": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "payload"
        ],
        "properties": {
          "event_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object",
            "description": "For task.dependency_added and task.dependency_removed, payload conforms to DependencyEventPayload; for task.dependency_state_changed, it conforms to DependencyStateChangedEventPayload; other event types define their own payload fields.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "TaskTimelineItem": {
        "type": "object",
        "required": [
          "id",
          "cursor",
          "kind",
          "task_id",
          "actor",
          "created_at",
          "progress",
          "comment",
          "change"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque stable keyset cursor for this activity item."
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent_progress",
              "comment",
              "task_change"
            ]
          },
          "task_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "actor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TimelineActor"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "progress": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TaskTimelineProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "comment": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Comment"
              },
              {
                "type": "null"
              }
            ]
          },
          "change": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TaskTimelineChange"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "TaskTimelineCollection": {
        "type": "object",
        "required": [
          "data",
          "next_cursor"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskTimelineItem"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Empty string when there is no next page; otherwise pass as before."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
