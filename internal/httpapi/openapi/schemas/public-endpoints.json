{
  "components": {
    "schemas": {
      "PublicEndpoint": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "hostname",
          "account_id",
          "zone_id",
          "tunnel_id",
          "dns_record_id",
          "status",
          "cleanup_pending",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "cloudflare"
            ]
          },
          "hostname": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "zone_id": {
            "type": "string"
          },
          "tunnel_id": {
            "type": "string"
          },
          "dns_record_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "cleanup_pending": {
            "type": "boolean",
            "description": "Cloudflare resources still exist because they were not deleted with an API token."
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "created_by_name": {
            "type": "string",
            "description": "Name of the administrator who created it, when known."
          },
          "disabled_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "additionalProperties": false
      },
      "PublicEndpointTestResult": {
        "type": "object",
        "required": [
          "endpoint_id",
          "ok",
          "checked_at",
          "latency_ms",
          "via_cloudflare",
          "message"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "checked_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "status_code": {
            "type": "integer"
          },
          "via_cloudflare": {
            "type": "boolean",
            "description": "The response carried Cloudflare's `CF-Ray` or `Server` header."
          },
          "cf_ray": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PublicEndpointView": {
        "type": "object",
        "required": [
          "connector",
          "history",
          "required_permissions",
          "exposed_paths",
          "connector_available"
        ],
        "properties": {
          "active": {
            "$ref": "#/components/schemas/PublicEndpoint"
          },
          "connector": {
            "type": "object",
            "required": [
              "state",
              "restarts"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "stopped",
                  "starting",
                  "connected",
                  "restarting",
                  "error"
                ]
              },
              "message": {
                "type": "string"
              },
              "started_at": {
                "type": "string"
              },
              "restarts": {
                "type": "integer",
                "minimum": 0
              },
              "connected_at": {
                "type": "string",
                "description": "When the current run first registered an edge connection."
              },
              "connections": {
                "type": "integer",
                "minimum": 0,
                "description": "Registered Cloudflare edge connections."
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Cloudflare data centres serving the connections, e.g. ord08."
              },
              "last_error_at": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "last_test": {
            "$ref": "#/components/schemas/PublicEndpointTestResult"
          },
          "public_hook_base": {
            "type": "string",
            "description": "Public prefix for ticket webhook URLs while active."
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicEndpoint"
            }
          },
          "required_permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exposed_paths": {
            "type": "string",
            "description": "Regular expression of the only paths routed publicly."
          },
          "connector_available": {
            "type": "boolean",
            "description": "Whether the cloudflared binary can run on this server; creation is refused when false."
          }
        },
        "additionalProperties": false
      },
      "PublicEndpointCreateRequest": {
        "type": "object",
        "required": [
          "hostname",
          "api_token"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "cloudflare"
            ],
            "default": "cloudflare"
          },
          "hostname": {
            "type": "string",
            "description": "Unused subdomain of a zone the token can edit, e.g. hooks.example.com."
          },
          "api_token": {
            "type": "string",
            "description": "Cloudflare API token used once and never stored."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
