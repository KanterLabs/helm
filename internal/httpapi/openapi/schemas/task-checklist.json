{
  "components": {
    "schemas": {
      "ChecklistCompletionPolicy": {
        "type": "string",
        "enum": [
          "warn",
          "require"
        ],
        "description": "Whether completing a task with open checklist items warns or is rejected."
      },
      "TaskChecklistItem": {
        "type": "object",
        "required": [
          "id",
          "task_id",
          "text",
          "position",
          "completed",
          "completed_at",
          "completed_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "task_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "completed": {
            "type": "boolean"
          },
          "completed_at": {
            "$ref": "#/components/schemas/NullableTimestamp"
          },
          "completed_by": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Identifier"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "updated_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "additionalProperties": false
      },
      "TaskChecklistSummary": {
        "type": "object",
        "required": [
          "total",
          "completed",
          "open",
          "percent",
          "completion_policy",
          "warning"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "open": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "completion_policy": {
            "$ref": "#/components/schemas/ChecklistCompletionPolicy"
          },
          "warning": {
            "type": "boolean",
            "description": "True when a completed task has open items under warn policy."
          }
        },
        "additionalProperties": false
      },
      "TaskChecklistCollection": {
        "type": "object",
        "required": [
          "task_id",
          "version",
          "data",
          "summary"
        ],
        "properties": {
          "task_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/TaskChecklistItem"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/TaskChecklistSummary"
          }
        },
        "additionalProperties": false
      },
      "TaskChecklistItemRequest": {
        "type": "object",
        "description": "Text is required; title is accepted as a compatibility alias.",
        "oneOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "title"
            ]
          }
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Compatibility alias for text."
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "TaskChecklistItemPatchRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "completed": {
            "type": "boolean"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "additionalProperties": false
      },
      "TaskChecklistReorderRequest": {
        "type": "object",
        "required": [
          "item_ids"
        ],
        "properties": {
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
