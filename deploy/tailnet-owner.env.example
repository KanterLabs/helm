# Copy this profile to /etc/roadmap/tailnet-owner.env on CT 106 as root,
# replace the admin-email placeholder with the existing Helm/Cloudflare admin
# email, then set owner root:root and mode 0600. This file contains no key
# bytes; provision those separately at the paths below.
HELM_ADDR=127.0.0.1:8080
HELM_DB=/var/lib/roadmap/data/roadmap.db
HELM_AUTH_MODE=tailnet
HELM_PUBLIC_ORIGIN=https://beta-helm.home.shanekanterman.dev
HELM_ADMIN_EMAIL=REPLACE_WITH_EXISTING_ADMIN_EMAIL
HELM_TAILNET_OWNER_LOGIN=ShaneKanterman04@github
HELM_TAILNET_AUDIENCE=https://beta-helm.home.shanekanterman.dev
HELM_TAILNET_ASSERTION_KEY_FILE=/etc/roadmap/tailnet.key
HELM_TAILNET_TLS_ADDR=10.0.0.39:8443
HELM_TAILNET_TLS_CERT_FILE=/etc/roadmap/tailnet-origin.crt
HELM_TAILNET_TLS_KEY_FILE=/etc/roadmap/tailnet-origin.key
HELM_TAILNET_ALLOWED_PEER_IPS=10.0.0.101
HELM_SECURE_COOKIES=true
HELM_DEMO_SEED=false

ROADMAP_ADDR=127.0.0.1:8080
ROADMAP_DB=/var/lib/roadmap/data/roadmap.db
ROADMAP_AUTH_MODE=tailnet
ROADMAP_PUBLIC_ORIGIN=https://beta-helm.home.shanekanterman.dev
ROADMAP_ADMIN_EMAIL=REPLACE_WITH_EXISTING_ADMIN_EMAIL
ROADMAP_TAILNET_OWNER_LOGIN=ShaneKanterman04@github
ROADMAP_TAILNET_AUDIENCE=https://beta-helm.home.shanekanterman.dev
ROADMAP_TAILNET_ASSERTION_KEY_FILE=/etc/roadmap/tailnet.key
ROADMAP_TAILNET_TLS_ADDR=10.0.0.39:8443
ROADMAP_TAILNET_TLS_CERT_FILE=/etc/roadmap/tailnet-origin.crt
ROADMAP_TAILNET_TLS_KEY_FILE=/etc/roadmap/tailnet-origin.key
ROADMAP_TAILNET_ALLOWED_PEER_IPS=10.0.0.101
ROADMAP_SECURE_COOKIES=true
ROADMAP_DEMO_SEED=false
